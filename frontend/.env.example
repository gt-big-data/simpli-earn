# Next.js frontend. Copy to frontend/.env.local. Never commit real keys.

# --- REQUIRED: Supabase browser authentication (anon/publishable key, never service_role) -------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend URLs (defaults in frontend/lib/api-config.ts) -------------------------------------
# Compiled into the bundle by `next build`: set them before building (Docker build args / Vercel
# env), not only on the running server. REQUIRED for any deployed build; the Docker build fails
# without them and `next build` warns.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTIMENT_API_URL=http://localhost:8001

# --- Server-only: REQUIRED for account deletion (/api/auth/delete-account) ----------------------
# service_role key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
