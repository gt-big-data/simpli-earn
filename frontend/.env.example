# Supabase browser authentication. Use the anon/publishable key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service_role key for account deletion. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local API URLs (defaults in frontend/lib/api-config.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTIMENT_API_URL=http://localhost:8001
