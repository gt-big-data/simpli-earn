# RAG API (uvicorn api_chatbot:app). Copy to RAG/.env. Never commit real keys.
# Startup prints any missing REQUIRED value; with STRICT_CONFIG=1 (Cloud Run) it refuses to start.

# --- LLM + embeddings: REQUIRED, at least one of the two keys --------------------------------
# OpenAI is preferred when set; Gemini is used otherwise, or for OPENAI_COOLDOWN_SECONDS after an
# OpenAI quota error. A Gemini key alone runs everything on Gemini.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (values shown are the defaults)
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_COOLDOWN_SECONDS=300
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: pin embeddings to openai or gemini (blank = follow the chat provider).
# FAISS indexes are kept per provider+model; see RAG/RAG_README.md.
EMBEDDING_PROVIDER=

# --- Supabase: REQUIRED -----------------------------------------------------------------------
SUPABASE_URL=
# service_role key (server-side only): database and storage access
SUPABASE_KEY=

# --- Dashboard creation pipeline (scripts/create_dashboard_from_youtube.py) -------------------
# The RAG API runs it for pasted YouTube links unless YOUTUBE_HOME_WORKER=1. The script also reads
# sentiment/.env, so these may live there instead.
# REQUIRED for dashboard creation: AssemblyAI transcription
ASSEMBLYAI_KEY=
# Optional: Hugging Face token, only if the sentiment models need gated access
HF_TOKEN=
# Optional: YouTube Data API key for video metadata (falls back to yt-dlp)
YOUTUBE_API_KEY=
# 0 (default): run the pipeline in this service. 1: only queue jobs for scripts/home_youtube_worker.py
YOUTUBE_HOME_WORKER=0
# Optional: users who may force-reprocess a complete dashboard (replacing its analysis).
# Others can only create dashboards or retry incomplete ones. Comma-separated.
DASHBOARD_ADMIN_USER_IDS=
DASHBOARD_ADMIN_EMAILS=

# --- Optional: extra browser origins allowed by CORS (comma-separated) ------------------------
# localhost:3000 and the Vercel URLs are always allowed. On Cloud Run, cloudbuild.yaml adds the
# frontend's URLs here automatically.
CORS_ALLOWED_ORIGINS=

# --- Optional tuning (values shown are the defaults) ----------------------------------------
# Most recent turns of browser-supplied chat history used per /chat request (the API keeps no chat
# state); at most 20, which is also the most a request may send
CHAT_MAX_TURNS=20
# Largest accepted request body in bytes (larger requests get 413 before parsing)
MAX_REQUEST_BODY_BYTES=1048576
# Transcript vector stores kept loaded in memory (LRU)
VECTORSTORE_CACHE_SIZE=32
# 1 = refuse to start when a REQUIRED value is missing (set on Cloud Run by cloudbuild.yaml)
STRICT_CONFIG=0
