# LLM + embeddings: set at least one of OPENAI_API_KEY / GEMINI_API_KEY.
# OpenAI is preferred when set; Gemini is used otherwise or after an OpenAI quota error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Optional: seconds to wait before retrying OpenAI after quota error
OPENAI_COOLDOWN_SECONDS=300

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: pin embeddings to openai or gemini (blank = follow the chat provider).
# FAISS indexes are kept per provider+model; see RAG/RAG_README.md.
EMBEDDING_PROVIDER=

# Supabase project credentials
SUPABASE_URL=
# Use service_role key for server-side database and storage access
SUPABASE_KEY=

# Optional: YouTube Data API Key
# Metadata lookup has a yt-dlp fallback if not provided
YOUTUBE_API_KEY=

# Local default: process YouTube jobs in the RAG API; set to 1 only with a running home worker.
YOUTUBE_HOME_WORKER=0

# Optional: chat memory is kept per conversation_id; idle conversations expire.
CHAT_SESSION_TTL_SECONDS=3600
CHAT_MAX_SESSIONS=1000
CHAT_MAX_TURNS=20
# Optional: transcript vector stores kept loaded in memory (LRU).
VECTORSTORE_CACHE_SIZE=32
