# Sentiment API (uvicorn api:app) and the sentiment scripts. Copy to sentiment/.env. Never commit real keys.
# Startup prints any missing REQUIRED value; with STRICT_CONFIG=1 (Cloud Run) it refuses to start.

# --- Supabase: REQUIRED -----------------------------------------------------------------------
SUPABASE_URL=
# service_role key (server-side only)
SUPABASE_KEY=

# --- Dashboard creation pipeline (scripts/create_dashboard_from_youtube.py) -------------------
# Not read by the sentiment API itself. The pipeline (run by the RAG API or the home worker) loads
# sentiment/.env first, then RAG/.env.
# REQUIRED for dashboard creation: AssemblyAI transcription
ASSEMBLYAI_KEY=
# Optional: Hugging Face token, only if the sentiment models need gated access
HF_TOKEN=

# --- Optional: home YouTube worker (scripts/home_youtube_worker.py; values shown are defaults) -
HOME_YOUTUBE_POLL_SEC=15
HOME_YOUTUBE_ONCE=
HOME_YOUTUBE_SCRIPT_TIMEOUT_SEC=7200

# 1 = refuse to start when a REQUIRED value is missing (set on Cloud Run by cloudbuild.yaml)
STRICT_CONFIG=0
