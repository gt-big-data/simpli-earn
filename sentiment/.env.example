# Supabase project credentials. Use a service_role key on this server.
SUPABASE_URL=
SUPABASE_KEY=

# Library deletes: the creator of a dashboard (video_analyses.created_by, docs/migrations/004) can delete it;
# these users can delete any entry and use the admin-only endpoints. Comma-separated.
LIBRARY_ADMIN_USER_IDS=
LIBRARY_ADMIN_EMAILS=

# Required for the YouTube audio transcription pipeline.
ASSEMBLYAI_KEY=

# Optional: needed only if the sentiment models require gated access.
HF_TOKEN=

# Optional: home YouTube worker settings (defaults in scripts/home_youtube_worker.py).
HOME_YOUTUBE_POLL_SEC=15
HOME_YOUTUBE_ONCE=
HOME_YOUTUBE_SCRIPT_TIMEOUT_SEC=7200
